# Pinterest API v5 Credentials (Copy this file to .env and fill in your values)
# Never commit .env to git (.env is already in .gitignore)

# Optional for quick testing if you generated a token directly in the Pinterest Developer Portal:
PINTEREST_ACCESS_TOKEN=

# Required for automatic OAuth login & auto-refresh (continuous_refresh):
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_REDIRECT_URI=http://localhost:8787/callback

# Use "sandbox" for Trial/Sandbox testing or "production" for live publishing (Standard Access):
PINTEREST_ENV=production

# Optional board privacy when auto-creating boards: PUBLIC | PROTECTED | SECRET
PINTEREST_BOARD_PRIVACY=PUBLIC
